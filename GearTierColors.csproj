<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GearTierColors</AssemblyName>
    <RootNamespace>GearTierColors</RootNamespace>
    <Version>1.0.0</Version>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SPTarkov.Common">
      <HintPath>C:\SPT\SPT_Runtime\SPTarkov.Common.dll</HintPath>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>C:\SPT\SPT_Runtime\SPTarkov.DI.dll</HintPath>
    </Reference>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>C:\SPT\SPT_Runtime\SPTarkov.Server.Core.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SemanticVersioning" Version="3.0.0" />
  </ItemGroup>
  <!-- Deploys straight into SPT on build, config included. -->
  <Target Name="CopyToServer" AfterTargets="PostBuildEvent">
    <MakeDir Directories="C:\SPT\SPT_Runtime\user\mods\GearTierColors" />
    <Copy SourceFiles="$(ProjectDir)$(OutDir)$(TargetName).dll"
          DestinationFolder="C:\SPT\SPT_Runtime\user\mods\GearTierColors" />
    <Copy SourceFiles="$(ProjectDir)config.json"
          DestinationFolder="C:\SPT\SPT_Runtime\user\mods\GearTierColors"
          Condition="!Exists('C:\SPT\SPT_Runtime\user\mods\GearTierColors\config.json')" />
  </Target>
</Project>
